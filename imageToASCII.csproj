<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>imageToASCII</RootNamespace>
    <AssemblyName>imageToASCII</AssemblyName>
    <!-- Properties/AssemblyInfo.cs already exists, so don't generate a second one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Drawing is built into .NET Framework, no NuGet package needed -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
